// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  ADMIN
  LEITOR
}

model User {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  password  String
  tipo      TipoUsuario @default(LEITOR)
  createdAt DateTime    @default(now())

  arquivos      Arquivo[]
  lugares       Lugar[]
  recomendacoes Recomendacao[]
  eventos       Evento[]
  setores       Setor[]
  noticias      Noticia[]
  historias     Historia[]
}

model Arquivo {
  id      Int    @id @default(autoincrement())
  tamanho Int
  tipo    String
  nome    String
  url     String

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])
}

model Lugar {
  id          Int    @id @default(autoincrement())
  nome        String
  observacao  String
  tipo        String
  localizacao String
  imagem      String

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])

  recomendacoes Recomendacao[]
}

model Recomendacao {
  id         Int    @id @default(autoincrement())
  avaliacao  Int
  titulo     String
  descricao  String
  observacao String

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])

  fk_id_lugar Int
  lugar       Lugar @relation(fields: [fk_id_lugar], references: [id])
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String
  local       String
  data_inicio DateTime
  data_fim    DateTime

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])

  setores EventoSetor[]
}

model Setor {
  id        Int    @id @default(autoincrement())
  descricao String
  nome      String

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])

  eventos EventoSetor[]
}

model EventoSetor {
  fk_id_evento Int
  fk_id_setor  Int

  evento Evento @relation(fields: [fk_id_evento], references: [id])
  setor  Setor  @relation(fields: [fk_id_setor], references: [id])

  @@id([fk_id_evento, fk_id_setor])
}

model Noticia {
  id              Int      @id @default(autoincrement())
  titulo          String
  conteudo        String
  data_publicacao DateTime
  imagem          String

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])
}

model Historia {
  id               Int      @id @default(autoincrement())
  titulo           String
  conteudo         String
  data_atualizacao DateTime

  fk_id_usuario Int
  usuario       User @relation(fields: [fk_id_usuario], references: [id])
}

model Categoria {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String

  paginas PaginaCurso[]
}

model PaginaCurso {
  id               Int      @id @default(autoincrement())
  titulo           String
  conteudo         String
  data_atualizacao DateTime

  fk_id_categoria Int
  categoria       Categoria @relation(fields: [fk_id_categoria], references: [id])

  cursos Curso[]
}

model Curso {
  id         Int    @id @default(autoincrement())
  nome       String
  descricao  String
  duracao    String
  turno      String
  modalidade String

  fk_id_pagina Int
  pagina       PaginaCurso @relation(fields: [fk_id_pagina], references: [id])
}